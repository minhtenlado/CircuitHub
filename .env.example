# Database connection string
# Local development (SQLite):
DATABASE_URL="file:./db/custom.db"

# Production deployment (PostgreSQL e.g. Neon.tech / Supabase):
# DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/circuithub?sslmode=require"

# NextAuth / App secrets (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="circuithub-production-secret-change-me"
NEXTAUTH_URL="https://circuithub.vercel.app"
NEXT_PUBLIC_APP_URL="https://circuithub.vercel.app"

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

